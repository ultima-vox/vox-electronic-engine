# cmake -DBUNDLES="<dir.vst3>|<CID>|<name>;..." -P CheckModuleInfo.cmake
# Reads Contents/Resources/moduleinfo.json that JUCE writes into each built
# VST3 bundle and compares the class ID and name with the frozen identity.
foreach(entry IN LISTS BUNDLES)
  string(REPLACE "|" ";" fields "${entry}")
  list(GET fields 0 bundle)
  list(GET fields 1 cid)
  list(GET fields 2 name)
  set(info "${bundle}/Contents/Resources/moduleinfo.json")
  if(NOT EXISTS "${info}")
    message(FATAL_ERROR "missing ${info}")
  endif()
  file(READ "${info}" json)
  string(JSON count LENGTH "${json}" "Classes")
  set(found FALSE)
  math(EXPR last "${count} - 1")
  foreach(i RANGE 0 ${last})
    string(JSON category GET "${json}" "Classes" ${i} "Category")
    if(category STREQUAL "Audio Module Class")
      string(JSON actualCid GET "${json}" "Classes" ${i} "CID")
      string(JSON actualName GET "${json}" "Classes" ${i} "Name")
      if(NOT actualCid STREQUAL cid OR NOT actualName STREQUAL name)
        message(FATAL_ERROR "${bundle}: component '${actualName}' ${actualCid}, expected '${name}' ${cid}")
      endif()
      set(found TRUE)
    endif()
  endforeach()
  if(NOT found)
    message(FATAL_ERROR "${bundle}: no Audio Module Class in moduleinfo.json")
  endif()
  message(STATUS "${name}: ${cid}")
endforeach()

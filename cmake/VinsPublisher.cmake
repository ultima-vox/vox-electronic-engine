# Publisher keys for native .vins packages (#73/#77), configured once.
#
# The Rack pins the public key it trusts at compile time. Native .vins carry
# an RSA-3072 PKCS#1 v1.5 SHA-256 signature over manifest.json.
# - Development (default): a key generated once inside this build tree signs
#   while packaging. Packages it signs load only in Racks built in the same
#   tree; build-info and the Rack label it as a development key. An untrusted
#   key is also generated for tests that need a foreign signature.
# - Release candidate (VOX_PRODUCTION_BUILD=ON): the build pins ONLY the
#   owner's release PUBLIC key (VOX_RELEASE_PUBLIC_KEY) and writes native
#   packages UNSIGNED to release-candidates/. The owner signs them offline
#   (docs/release/RELEASE_SIGNING.md); no private key ever enters a build,
#   a runner, the repository or a log.
find_program(VOX_OPENSSL openssl
  HINTS "C:/Program Files/Git/usr/bin" "C:/Program Files/Git/mingw64/bin")
if(NOT VOX_OPENSSL)
  message(FATAL_ERROR "openssl is required to sign native .vins packages "
    "(Git for Windows ships one in C:/Program Files/Git/usr/bin)")
endif()
set(VOX_RELEASE_PUBLIC_KEY "" CACHE FILEPATH
  "Owner's release publisher PUBLIC key (PEM), required by VOX_PRODUCTION_BUILD.")
set(VOX_PUBLISHER_DIR ${CMAKE_BINARY_DIR}/publisher)
file(MAKE_DIRECTORY ${VOX_PUBLISHER_DIR})

function(_vox_generate_key path)
  if(NOT EXISTS "${path}")
    execute_process(COMMAND ${VOX_OPENSSL} genrsa -out "${path}" 3072
      RESULT_VARIABLE rc OUTPUT_QUIET ERROR_QUIET)
    if(NOT rc EQUAL 0)
      message(FATAL_ERROR "openssl genrsa failed (${rc})")
    endif()
  endif()
endfunction()

function(_vox_public_modulus key out_modulus)
  set(pubin "")
  if(ARGC GREATER 2 AND ARGV2 STREQUAL "PUBLIC")
    set(pubin "-pubin")
  endif()
  execute_process(COMMAND ${VOX_OPENSSL} rsa ${pubin} -in "${key}" -modulus -noout
    OUTPUT_VARIABLE modulus RESULT_VARIABLE rc ERROR_QUIET OUTPUT_STRIP_TRAILING_WHITESPACE)
  execute_process(COMMAND ${VOX_OPENSSL} rsa ${pubin} -in "${key}" -text -noout
    OUTPUT_VARIABLE text RESULT_VARIABLE rc2 ERROR_QUIET)
  if(NOT rc EQUAL 0 OR NOT rc2 EQUAL 0 OR NOT modulus MATCHES "^Modulus=[0-9A-F]+$")
    message(FATAL_ERROR "cannot read the RSA public key of ${key}")
  endif()
  if(NOT text MATCHES "(publicExponent|Exponent): 65537 ")
    message(FATAL_ERROR "publisher key ${key}: public exponent must be 65537")
  endif()
  string(REPLACE "Modulus=" "" modulus "${modulus}")
  string(LENGTH "${modulus}" hex_length)
  if(hex_length LESS 768)
    message(FATAL_ERROR "publisher key ${key}: at least 3072 bits required")
  endif()
  set(${out_modulus} "${modulus}" PARENT_SCOPE)
endfunction()

# A release candidate pins only the owner's release public key; there is no
# development-key fallback and no private key input (#77 gate 3, #78 §5).
option(VOX_PRODUCTION_BUILD "Configure a release candidate (requires VOX_RELEASE_PUBLIC_KEY)" OFF)
include(${CMAKE_CURRENT_LIST_DIR}/VinsProductionGate.cmake)
if(VOX_PRODUCTION_BUILD)
  set(VOX_PUBLISHER_KEY "") # nothing signs inside a release build
  set(VOX_PUBLISHER_LABEL "Ultima Vox release publisher key")
  _vox_public_modulus("${VOX_RELEASE_PUBLIC_KEY}" VOX_PUBLISHER_MODULUS PUBLIC)
  message(STATUS "vins: RELEASE CANDIDATE - native packages are written unsigned for offline signing")
else()
  set(VOX_PUBLISHER_KEY ${VOX_PUBLISHER_DIR}/development-key.pem)
  _vox_generate_key(${VOX_PUBLISHER_KEY})
  set(VOX_PUBLISHER_LABEL "development key of this build tree (not a release key)")
  message(STATUS "vins: DEVELOPMENT build - native packages are signed with a per-build key")
  _vox_public_modulus(${VOX_PUBLISHER_KEY} VOX_PUBLISHER_MODULUS)
endif()
set(VOX_UNTRUSTED_TEST_KEY ${VOX_PUBLISHER_DIR}/untrusted-test-key.pem)
_vox_generate_key(${VOX_UNTRUSTED_TEST_KEY})
_vox_public_modulus(${VOX_UNTRUSTED_TEST_KEY} VOX_UNTRUSTED_MODULUS)
set(VOX_PUBLISHER_MODULUS_FILE ${VOX_PUBLISHER_DIR}/publisher.modulus)
set(VOX_UNTRUSTED_MODULUS_FILE ${VOX_PUBLISHER_DIR}/untrusted-test.modulus)
file(WRITE ${VOX_PUBLISHER_MODULUS_FILE} "Modulus=${VOX_PUBLISHER_MODULUS}\n")
file(WRITE ${VOX_UNTRUSTED_MODULUS_FILE} "Modulus=${VOX_UNTRUSTED_MODULUS}\n")

set(_keys_header ${CMAKE_BINARY_DIR}/generated/VoxPublisherKeys.h)
file(WRITE ${_keys_header}.tmp
"// Generated by cmake/VinsPublisher.cmake. Do not edit.
#pragma once
#include <cstdint>
namespace vstengine::instrument::vins::generated {
struct Key {
  const char *label;
  const char *modulusHex;
  std::uint32_t exponent;
};
inline constexpr Key keys[] = {
    {\"${VOX_PUBLISHER_LABEL}\", \"${VOX_PUBLISHER_MODULUS}\", 65537u},
};
} // namespace vstengine::instrument::vins::generated
")
configure_file(${_keys_header}.tmp ${_keys_header} COPYONLY)

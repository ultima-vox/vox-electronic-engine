file(READ "${CHECKLIST}" checklist)
string(TOLOWER "${checklist}" text)
foreach(forbidden "final head of pr 125" "seven distinct styles" "testeditor: eight pages" "all eight pages" "previous build (drm-04b)")
  string(FIND "${text}" "${forbidden}" found)
  if(NOT found EQUAL -1)
    message(FATAL_ERROR "Obsolete Drums release requirement: ${forbidden}")
  endif()
endforeach()
foreach(required "exact integrated commit" "23 factory styles" "kit, pattern and song" "not release-ready" "tab and shift-tab" "cubase" "reaper")
  string(FIND "${text}" "${required}" found)
  if(found EQUAL -1)
    message(FATAL_ERROR "Missing Drums release requirement: ${required}")
  endif()
endforeach()

file(READ "${CHECKLIST}" original)
foreach(stale "final HEAD of PR 125" "final HEAD of PR **#125**" "seven distinct styles" "`testEditor`: eight pages" "eight-page editor" "previous build (DRM-04b)")
  file(WRITE "${WORK}" "${original}\n${stale}\n")
  execute_process(COMMAND "${CMAKE_COMMAND}" "-DCHECKLIST=${WORK}" -P "${GUARD}"
                  RESULT_VARIABLE status OUTPUT_QUIET ERROR_QUIET)
  if(status EQUAL 0)
    file(REMOVE "${WORK}")
    message(FATAL_ERROR "Guard accepted obsolete requirement: ${stale}")
  endif()
endforeach()
file(REMOVE "${WORK}")
execute_process(COMMAND "${CMAKE_COMMAND}" "-DCHECKLIST=${CHECKLIST}" -P "${GUARD}" RESULT_VARIABLE status)
if(NOT status EQUAL 0)
  message(FATAL_ERROR "Guard rejected the current acceptance checklist")
endif()

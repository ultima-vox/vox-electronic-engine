{
  "compilerOptions": {
    "target": "ES2022", "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"], "module": "ESNext",
    "skipLibCheck": true, "moduleResolution": "Bundler", "allowImportingTsExtensions": true,
    "isolatedModules": true, "verbatimModuleSyntax": true, "noEmit": true,
    "jsx": "react-jsx", "strict": true, "noUnusedLocals": true, "noUnusedParameters": true,
    "types": ["vite/client", "node"]
  },
  "include": ["src", "e2e", "*.config.ts"]
}
